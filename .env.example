# Kalshi (production)
KALSHI_API_KEY=
KALSHI_PRIVATE_KEY_PATH=
# Or inline PEM (use one of PATH or PEM)
# KALSHI_PRIVATE_KEY_PEM=
KALSHI_BASE_URL=https://external-api.kalshi.com/trade-api/v2
KALSHI_WS_URL=wss://external-api-ws.kalshi.com/trade-api/ws/v2
# Kalshi series for weekly EIA natural gas storage brackets
KALSHI_GAS_STORAGE_SERIES=KXGAS

# Polymarket CLOB
POLYMARKET_PK=
POLYMARKET_HOST=https://clob.polymarket.com
POLYMARKET_CHAIN_ID=137
POLYMARKET_SIGNATURE_TYPE=0
POLYMARKET_FUNDER=
CLOB_API_KEY=
CLOB_SECRET=
CLOB_PASS_PHRASE=

# Gamma API (market discovery)
GAMMA_API_URL=https://gamma-api.polymarket.com

# Runtime
NULLONE_LOG_DIR=logs/releases
NULLONE_MODE=paper
# Max USD notional per release. single_leg spends it on winner YES; auto tries winner YES + loser NO.
NULLONE_RELEASE_CAPITAL_USD=50
NULLONE_EXECUTION_STRATEGY=auto

# Multi-leg allocation knobs used when NULLONE_EXECUTION_STRATEGY=auto
NULLONE_PARSE_ERROR_RATE=0.02
NULLONE_MIN_LEG_USD=5
NULLONE_MAX_LEGS=6
NULLONE_MIN_FILL_PROB=0.3
NULLONE_MIN_EDGE=0.05
NULLONE_WINNER_YES_MIN_PCT=0.5
NULLONE_MAX_LEG_USD=
NULLONE_BOOK_DEPTH_USD=100
NULLONE_MAX_SLIPPAGE_YES=0.02
NULLONE_ABSOLUTE_FLOOR_YES=0.01
NULLONE_FORCE_WINNER_FIRST=true
NULLONE_ENABLE_LOSER_NO=true
NULLONE_KALSHI_FEE_RATE=0.01
NULLONE_BATCH_FALLBACK_SINGLE=false
NULLONE_PRESIGN_BATCH_HEADERS=false
NULLONE_PRESIGN_INTERVAL_MS=200
